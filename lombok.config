# Sin esto, @RequiredArgsConstructor NO copia @Qualifier del campo al parámetro
# del constructor y Spring inyecta por TIPO: en el perfil cloud (donde el bean
# cloudJdbcTemplate no existe) CatalogSyncService recibía el JdbcTemplate
# PRIMARIO y "sincronizaba" el catálogo contra la misma DB en cada login
# (~60 s con el catálogo real de prod). Ver docs/220.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
